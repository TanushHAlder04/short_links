# Copy to .env.local for Next.js. Prisma/scripts also read .env.
# Runtime pooled Supabase URI; copy the username/tenant exactly from Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migration-capable direct/session connection; do not run migrations on transaction pooling.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_HOST=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IP_HASH_SALT=replace-with-at-least-32-random-characters
# Local development only; NEVER set INNGEST_DEV in production.
INNGEST_DEV=1
# Set these in production, with the deployed /api/inngest endpoint registered.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional server error-code monitoring (no request payloads).
SENTRY_DSN=
# Optional per-minute overrides.
RATE_LIMIT_ANONYMOUS=10
RATE_LIMIT_AUTHENTICATED=50
RATE_LIMIT_API_KEY=100
RATE_LIMIT_IMPORT=3
RATE_LIMIT_DASHBOARD=60
RATE_LIMIT_SCANNING=60

# Authenticated CSV/PDF export limits (UTC ranges are at most 366 days).
RATE_LIMIT_EXPORT=5
EXPORT_MAX_LINKS=1000
EXPORT_MAX_AGGREGATE_ROWS=20000
EXPORT_MAX_RAW_ROWS=10000
